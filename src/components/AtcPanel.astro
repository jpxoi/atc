---
import Play from "@lucide/astro/icons/play";
import Square from "@lucide/astro/icons/square";
import Volume2 from "@lucide/astro/icons/volume-2";
import VolumeOff from "@lucide/astro/icons/volume-off";
import type { Airport } from "../data/airports";
import { liveAtcSearchUrl, streamUrl } from "../data/airports";

interface Props {
  airports: Airport[];
  selectedIcao: string;
}

const { airports, selectedIcao } = Astro.props;
const atcAirports = airports.filter((airport) => airport.feeds.length > 0);

const badgeClass =
  "shrink-0 rounded-full px-2 py-0.5 text-xs font-medium text-white data-[state=idle]:bg-gray-400 data-[state=connecting]:bg-amber-500 data-[state=live]:bg-red-500 data-[state=offline]:bg-zinc-800 dark:data-[state=idle]:bg-gray-500 dark:data-[state=connecting]:bg-amber-600 dark:data-[state=live]:bg-red-600 dark:data-[state=offline]:bg-black";

const iconClass = "pointer-events-none";
---

<section class="flex flex-col space-y-4">
  <h2 class="text-xl font-semibold">Live ATC</h2>
  {
    atcAirports.map((airport) => (
      <div
        data-airport-atc={airport.icao}
        hidden={airport.icao !== selectedIcao}
        class="space-y-3"
      >
        <div class="grid grid-cols-1 gap-3">
          {airport.feeds.map((feed) => (
            <article
              data-atc-feed
              class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800 data-[listening=true]:border-emerald-400 data-[listening=true]:ring-1 data-[listening=true]:ring-emerald-400/80"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-base font-semibold">{feed.title}</h3>
                <span
                  data-atc-indicator
                  data-state="idle"
                  class={badgeClass}
                >
                  Idle
                </span>
              </div>
              <div class="mt-1 grid grid-cols-[1fr_auto] gap-x-4 gap-y-0.5 text-sm">
                {feed.facilities.map((facility) => (
                  <>
                    <p class="text-gray-500 dark:text-gray-400">{facility.name}</p>
                    <p class="text-right font-mono tabular-nums tracking-wide text-gray-900 dark:text-gray-100">
                      {facility.frequency}
                    </p>
                  </>
                ))}
              </div>
              <div class="mt-4 flex items-center gap-2">
                <button
                  type="button"
                  data-atc-toggle
                  aria-pressed="false"
                  aria-label={`Play ${feed.title}`}
                  class="group flex size-10 items-center justify-center rounded-full border border-gray-300 text-gray-800 hover:bg-gray-100 aria-pressed:border-red-600 aria-pressed:bg-red-600 aria-pressed:text-white dark:border-gray-600 dark:text-gray-100 dark:hover:bg-gray-700 dark:aria-pressed:border-red-600 dark:aria-pressed:bg-red-600"
                >
                  <Play
                    size={16}
                    fill="currentColor"
                    stroke="none"
                    class:list={[iconClass, "group-aria-pressed:hidden"]}
                  />
                  <Square
                    size={12}
                    fill="currentColor"
                    stroke="none"
                    class:list={[iconClass, "hidden group-aria-pressed:block"]}
                  />
                </button>
                <button
                  type="button"
                  data-atc-listen
                  hidden
                  disabled
                  aria-pressed="false"
                  aria-label={`Listen to ${feed.title}`}
                  class="group flex size-10 items-center justify-center rounded-full border border-gray-300 text-gray-500 hover:bg-gray-100 aria-pressed:border-emerald-500 aria-pressed:bg-emerald-50 aria-pressed:text-emerald-600 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-700 dark:aria-pressed:border-emerald-500 dark:aria-pressed:bg-emerald-950 dark:aria-pressed:text-emerald-400"
                >
                  <VolumeOff
                    size={16}
                    class:list={[iconClass, "group-aria-pressed:hidden"]}
                  />
                  <Volume2
                    size={16}
                    class:list={[iconClass, "hidden group-aria-pressed:block"]}
                  />
                </button>
                <audio
                  class="hidden"
                  data-atc-audio
                  data-src={streamUrl(feed.mount)}
                  preload="none"
                  muted
                >
                  <source src={streamUrl(feed.mount)} type="audio/mpeg" />
                </audio>
              </div>
            </article>
          ))}
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400">
          <a
            href={liveAtcSearchUrl(airport.icao)}
            target="_blank"
            rel="noreferrer"
            class="hover:text-blue-600 dark:hover:text-blue-400"
          >
            LiveATC
          </a>
        </p>
      </div>
    ))
  }
  <p
    id="atc-empty"
    hidden={atcAirports.some((airport) => airport.icao === selectedIcao)}
    class="rounded-xl border border-dashed border-gray-300 p-4 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-400"
  >
    No LiveATC feeds for this airport.
  </p>
</section>
