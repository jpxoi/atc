---
import type { Airport } from "../data/airports";
import { liveAtcSearchUrl, streamUrl } from "../data/airports";

interface Props {
  airports: Airport[];
  selectedIcao: string;
}

const { airports, selectedIcao } = Astro.props;
const atcAirports = airports.filter((airport) => airport.feeds.length > 0);
---

<section class="flex flex-col space-y-4">
  <h2 class="text-2xl font-bold">🗼 Live ATC</h2>
  {
    atcAirports.map((airport) => (
      <div
        data-airport-atc={airport.icao}
        hidden={airport.icao !== selectedIcao}
        class="space-y-4 rounded-lg bg-gray-100 p-4 dark:bg-gray-800"
      >
        <div class="flex flex-col space-y-1">
          <h3 class="text-xl font-bold">
            {airport.iata} / {airport.icao} Air Traffic Control
          </h3>
          <a
            href={liveAtcSearchUrl(airport.icao)}
            target="_blank"
            rel="noreferrer"
            class="text-sm text-blue-500 hover:text-blue-700"
          >
            LiveATC {airport.icao} feeds ↗
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4">
          {airport.feeds.map((feed) => (
            <div data-atc-feed class="flex flex-col space-y-2">
              <div class="flex flex-row items-start justify-between space-x-4">
                <div class="flex flex-col space-y-1">
                  <h4 class="text-lg font-bold">{feed.title}</h4>
                  <ul class="text-sm text-gray-600 dark:text-gray-400">
                    {feed.facilities.map((facility) => (
                      <li>
                        {facility.name}
                        <span class="text-gray-700 dark:text-gray-300">
                          {" "}
                          {facility.frequency}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
                <span
                  data-atc-indicator
                  class="shrink-0 rounded-lg bg-gray-500 px-2 py-1 text-sm text-white dark:bg-gray-700"
                >
                  Offline
                </span>
              </div>
              <audio controls class="w-full" data-atc-audio preload="none">
                <source src={streamUrl(feed.mount)} type="audio/mpeg" />
                Your browser does not support the audio element.
              </audio>
            </div>
          ))}
        </div>
      </div>
    ))
  }
  <p
    id="atc-empty"
    hidden={atcAirports.some((airport) => airport.icao === selectedIcao)}
    class="rounded-lg bg-gray-100 p-4 text-sm text-gray-600 dark:bg-gray-800 dark:text-gray-400"
  >
    No LiveATC feeds for this airport.
  </p>
</section>
