---
import type { Airport } from "../data/airports";
import { metarSiteUrl } from "../lib/metar";

interface Props {
  airport: Airport;
}

const { airport } = Astro.props;
---

<section class="flex flex-col space-y-4 lg:sticky lg:top-4 lg:self-start">
  <h2 class="text-xl font-semibold">METAR</h2>
  <div
    class="flex flex-col items-center justify-center space-y-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
  >
    <div id="metar-widget" class="flex min-h-67.5 w-full items-center justify-center">
      <a
        class="block h-67.5 w-75 text-lg font-medium text-black dark:text-white sm:w-125 lg:w-full"
        href={metarSiteUrl(airport.icao)}
        id="metartaf-atcDash"
      >
        METAR {airport.name}
      </a>
    </div>
  </div>
</section>
