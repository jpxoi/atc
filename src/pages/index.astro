---
import AirportSwitcher from "../components/AirportSwitcher.astro";
import AtcPanel from "../components/AtcPanel.astro";
import MetarPanel from "../components/MetarPanel.astro";
import { DEFAULT_ICAO, airports, getAirport } from "../data/airports";
import Layout from "../layouts/Layout.astro";

const selectedAirport = getAirport(DEFAULT_ICAO) ?? airports[0];
---

<Layout>
  <main class="mx-auto max-w-6xl space-y-8 p-4">
    <header class="space-y-4">
      <h1 class="text-3xl font-bold">ATC Dashboard</h1>
      <AirportSwitcher
        airports={airports}
        selectedIcao={selectedAirport.icao}
      />
    </header>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <AtcPanel airports={airports} selectedIcao={selectedAirport.icao} />
      <MetarPanel airport={selectedAirport} />
    </div>
  </main>
</Layout>

<script>
  import { airports } from "../data/airports";
  import { initDashboard } from "../lib/dashboard";
  import { initMetarEmbeds } from "../lib/metar";
  import { whenReady } from "../lib/dom";

  whenReady(() => {
    initMetarEmbeds();
    initDashboard(airports);
  });
</script>
