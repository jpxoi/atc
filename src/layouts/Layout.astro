---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ATC Dashboard | Air Traffic Control",
  description = "Live air traffic control audio and METAR for Peruvian airports.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="ATC, Air Traffic Control, METAR, Aviation, Live ATC, Peru"
    />
    <meta name="author" content="Jean Paul Fernandez" />
    <meta name="robots" content="index, follow" />

    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111827"
      media="(prefers-color-scheme: dark)"
    />

    <meta name="twitter:site" content="@jpxoi" />
    <meta name="twitter:creator" content="@jpxoi" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://atc.jpxoi.com" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ATC Dashboard" />
    <meta property="og:locale" content="en_US" />
  </head>
  <body class="dark:bg-gray-900 dark:text-white">
    <slot />
  </body>
</html>
